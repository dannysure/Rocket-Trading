# ============================================================================
# ROCKET TRADING - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the required values
# DO NOT commit .env to version control!
# ============================================================================

# ============================================================================
# OAUTH 2.0 - GOOGLE
# ============================================================================
# Google OAuth is used for client sign-in. Admin users sign in at /admin/login
# with their username or email and password.
#
# Set the authorized redirect URI to:
# http://localhost:8081/login/oauth2/code/google
# Keep the client secret private and never commit to version control.
#
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Local Development: Use PostgreSQL on localhost
# Docker: PostgreSQL container listens on port 5435
#
DB_NAME=team_rocket_db
DB_USERNAME=team_rocket_admin
DB_PASSWORD=team_rocket_password123
DB_PORT=5432

# ============================================================================
# JWT SECURITY (Authentication Tokens)
# ============================================================================
# Signs sign-in tokens. Generate your own: openssl rand -base64 48
# Left empty (or set to the old published development value), the API signs with a random key that
# lasts until restart, so everyone signs in again after a restart and the analytics API stays closed.
#
JWT_SECRET=
JWT_ISSUER=rocket-trading
JWT_EXPIRATION_HOURS=8

# Analytics cache administration
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-token

# ============================================================================
# APPLICATION PORTS & URLs
# ============================================================================
# Backend Java API Server
SERVER_PORT=8081
API_BASE_URL=http://localhost:8081/api/v1

# Frontend Angular Application
FRONTEND_URL=http://localhost:4200

# ============================================================================
# QUOTE PROVIDER (Fauxnance - Mock Data)
# ============================================================================
# Uses mock quote service for development
# For production, integrate with real quote provider
#
FAUXNANCE_API_KEY=demo-key-change-this
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com
FAUXNANCE_STOCK_PATH=/v1/quotes/{symbol}
FAUXNANCE_CRYPTO_PATH=/v1/quotes/{symbol}
# Max quote age accepted for pricing (BR-08 "current" quote); 15 min matches standard delayed market data
FAUXNANCE_MAX_AGE_SECONDS=900
# FX rates are published as daily closes; 4 days covers weekends and holidays
FAUXNANCE_FX_MAX_AGE_SECONDS=345600
# Accept quotes Fauxnance flags stale (its cache missed a refresh) while within the max age; recorded in the audit trail
FAUXNANCE_ALLOW_STALE=true

# ============================================================================
# PERPETUAL FUTURES
# ============================================================================
# Live spot index from Coinbase Exchange public market data (no key); Fauxnance is used while it is down
PERPS_PRICE_FEED_ENABLED=true

# ============================================================================
# TRADING WORKER (Automated Order Matching)
# ============================================================================
# Enables background worker that matches buy/sell orders
#
TRADING_WORKER_ENABLED=true
TRADING_WORKER_DELAY_MS=1000
# An accepted order whose market has no current price (e.g. closed) is retried at this
# interval and rejected as expired after TRADING_DEFERRAL_MAX_HOURS
TRADING_DEFERRAL_RETRY_SECONDS=300
TRADING_DEFERRAL_MAX_HOURS=96

# ============================================================================
# REPORTING (BR-16)
# ============================================================================
# Orders are copied to the reporting database on this schedule; analyst queries never touch trading tables
REPORTING_REFRESH_MS=30000
# The reporting database. docker compose runs its own server (reporting-db); natively, leave the URL
# empty to use a separate "reporting" schema and connection pool on the trading database instead
REPORTING_DB_URL=
REPORTING_DB_NAME=rocket_reporting
REPORTING_DB_USERNAME=rocket_reporting
REPORTING_DB_PASSWORD=rocket_reporting_password

# ============================================================================
# REPRESENTATIVE SIGN-IN FIXTURE (local/demo only)
# ============================================================================
# When set, startup creates these accounts with this password (existing passwords are kept):
#   joanna@example.com     client with $10,000 practice cash
#   priya@rocket.internal  commercial analyst  -> Insights
#   david@rocket.internal  trading operations  -> Insights + Trade lookup
# Leave empty in any shared or production environment.
FIXTURE_PASSWORD=

# ============================================================================
# LOGGING & DEBUG (Optional)
# ============================================================================
# Uncomment for verbose logging during development
#
# LOG_LEVEL=DEBUG
