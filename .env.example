# ============================================================================
# ROCKET TRADING - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the required values
# DO NOT commit .env to version control!
# ============================================================================

# ============================================================================
# OAUTH 2.0 - GITHUB (REQUIRED)
# ============================================================================
# Create OAuth App at: https://github.com/settings/developers
# Instructions: https://docs.github.com/en/developers/apps/building-oauth-apps/creating-an-oauth-app
#
# 1. Go to GitHub Settings → Developer settings → OAuth Apps → Your App
# 2. Set Authorization callback URL: http://localhost:8081/login/oauth2/code/github
#    (THIS IS THE BACKEND ENDPOINT - NOT THE FRONTEND)
# 3. Copy Client ID and Client Secret below
# 4. Keep Client Secret PRIVATE - never commit to version control
#
OAUTH_GITHUB_CLIENT_ID=your_github_client_id_here
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:8081/login/oauth2/code/github

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Local Development: Use PostgreSQL on localhost
# Docker: PostgreSQL container listens on port 5435
#
DB_NAME=team_rocket_db
DB_USERNAME=team_rocket_admin
DB_PASSWORD=team_rocket_password123
DB_PORT=5432

# ============================================================================
# JWT SECURITY (Authentication Tokens)
# ============================================================================
# IMPORTANT: Change JWT_SECRET in production!
# Generate a secure random string for production
#
JWT_SECRET=change-me-development-jwt-secret-1234567890
JWT_ISSUER=rocket-trading
JWT_EXPIRATION_HOURS=8

# ============================================================================
# APPLICATION PORTS & URLs
# ============================================================================
# Backend Java API Server
SERVER_PORT=8081
API_BASE_URL=http://localhost:8081/api/v1

# Frontend Angular Application
FRONTEND_URL=http://localhost:4200

# ============================================================================
# QUOTE PROVIDER (Fauxnance - Mock Data)
# ============================================================================
# Uses mock quote service for development
# For production, integrate with real quote provider
#
FAUXNANCE_API_KEY=demo-key-change-this
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com
FAUXNANCE_STOCK_PATH=/v1/quotes/{symbol}
FAUXNANCE_CRYPTO_PATH=/v1/quotes/{symbol}
# Max quote age accepted for pricing (BR-08 "current" quote); 15 min matches standard delayed market data
FAUXNANCE_MAX_AGE_SECONDS=900
# Accept quotes Fauxnance flags stale (its cache missed a refresh) while within the max age; recorded in the audit trail
FAUXNANCE_ALLOW_STALE=true

# ============================================================================
# TRADING WORKER (Automated Order Matching)
# ============================================================================
# Enables background worker that matches buy/sell orders
#
TRADING_WORKER_ENABLED=true
TRADING_WORKER_DELAY_MS=1000

# ============================================================================
# KAFKA (Optional - for local development without Kafka)
# ============================================================================
# Set to false for local development if Kafka is not running
# Uncomment KAFKA_BOOTSTRAP_SERVERS below to enable Kafka
#
KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================================================
# PYTHON API (Optional - Analytics & ETL)
# ============================================================================
# Uncomment to enable Python API server
#
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4

# ============================================================================
# LOGGING & DEBUG (Optional)
# ============================================================================
# Uncomment for verbose logging during development
#
# LOG_LEVEL=DEBUG
