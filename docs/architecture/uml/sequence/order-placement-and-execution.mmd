sequenceDiagram
    participant Client as "Retail Client"
    participant Frontend as "Frontend App"
    participant Gateway as "API Gateway"
    participant SessionSvc as "Session Service"
    participant TradingCore as "Trading Core"
    participant MarketData as "Market Data Service"
    participant TradingDB as "Trading Database"
    participant EventBus as "Event Bus"
    participant Reporting as "Reporting Service"

    Client->>Frontend: Enter instrument, side, and quantity
    Frontend->>Gateway: Request indicative price
    Gateway->>MarketData: Get latest market quote
    MarketData-->>Gateway: Return indicative quote
    Gateway-->>Frontend: Show indicative price

    Client->>Frontend: Confirm order submission
    Frontend->>Gateway: Submit authenticated order
    Gateway->>SessionSvc: Validate session and client scope
    SessionSvc-->>Gateway: Session valid
    Gateway->>TradingCore: Validate and place order

    alt Trading rules fail
        TradingCore-->>Gateway: Reject order with business reason
        Gateway-->>Frontend: Show rejected status
    else Trading rules pass
        TradingCore->>TradingDB: Record accepted order
        TradingDB-->>TradingCore: Accepted order stored
        TradingCore->>MarketData: Get execution quote
        MarketData-->>TradingCore: Return current quote

        alt Quote supports execution
            TradingCore->>TradingDB: Commit fill, holdings, cash, and blotter update
            TradingDB-->>TradingCore: Atomic portfolio update complete
            TradingCore->>EventBus: Publish accepted and filled events
            EventBus-)Reporting: Refresh reporting projections
            TradingCore-->>Gateway: Return filled outcome
            Gateway-->>Frontend: Show accepted or filled status
            Gateway-)Frontend: Push live status update
        else Quote unavailable or instrument not tradable
            TradingCore->>TradingDB: Persist rejection after acceptance
            TradingDB-->>TradingCore: Rejection recorded with audit trail
            TradingCore->>EventBus: Publish accepted and rejected events
            EventBus-)Reporting: Refresh reporting projections
            TradingCore-->>Gateway: Return rejected outcome
            Gateway-->>Frontend: Show rejected status
            Gateway-)Frontend: Push live status update
        end
    end
